{
  "name": "@art-catalogue/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply art-catalogue --local",
    "db:migrate:remote": "wrangler d1 migrations apply art-catalogue --remote"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "@hono/zod-validator": "^0.2.2",
    "drizzle-orm": "^0.31.0",
    "zod": "^3.23.0",
    "@art-catalogue/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "drizzle-kit": "^0.22.0",
    "wrangler": "^3.60.0",
    "@cloudflare/workers-types": "^4.20240718.0"
  }
}
